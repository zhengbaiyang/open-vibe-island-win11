<UserControl x:Class="OpenIsland.App.Controls.BarsGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="28" Height="28"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <!-- v6 UnifiedBars glyph: 24x24 box, three 2.5px wide pill bars centered on y=12. -->
    <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border x:Name="Bar0" Width="2.5" Height="12" CornerRadius="1.25" Canvas.Left="5.25" Canvas.Top="6"
                RenderTransformOrigin="0.5,0.5" Background="#F1EAD9">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Scale0" ScaleY="0.25"/>
            </Border.RenderTransform>
        </Border>
        <Border x:Name="Bar1" Width="2.5" Height="14" CornerRadius="1.25" Canvas.Left="10.75" Canvas.Top="5"
                RenderTransformOrigin="0.5,0.5" Background="#F1EAD9">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Scale1" ScaleY="0.357"/>
            </Border.RenderTransform>
        </Border>
        <Border x:Name="Bar2" Width="2.5" Height="10" CornerRadius="1.25" Canvas.Left="16.25" Canvas.Top="7"
                RenderTransformOrigin="0.5,0.5" Background="#F1EAD9">
            <Border.RenderTransform>
                <ScaleTransform x:Name="Scale2" ScaleY="0.3"/>
            </Border.RenderTransform>
        </Border>
    </Canvas>
</UserControl>
