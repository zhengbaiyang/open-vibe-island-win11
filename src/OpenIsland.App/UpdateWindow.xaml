<Window x:Class="OpenIsland.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Island 更新"
        Width="580"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontBody}"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1A202B" BorderBrush="#303949" BorderThickness="1"
                                CornerRadius="8" Padding="9,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Rounded, softly shadowed window surface matching SettingsWindow. -->
    <Grid x:Name="RootFrame" Margin="20,18,20,22">
        <Border Margin="1" CornerRadius="15" Background="#0B0D10" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.18"
                                  RenderingBias="Quality"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="16" BorderBrush="#262C38" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E1117" Offset="0"/>
                    <GradientStop Color="#0B0D10" Offset="0.55"/>
                    <GradientStop Color="#0A0C10" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= Title bar ================= -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Style="{StaticResource BrandMark}" Width="26" Height="26" CornerRadius="8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="3" Height="8.5" CornerRadius="1.5" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <Border Width="3" Height="11" CornerRadius="1.5" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TitleBarText" FontFamily="{StaticResource FontDisplay}"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource CloseWindowButton}"
                        Margin="0,0,12,0" VerticalAlignment="Center" Click="CloseButton_Click">
                    <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                </Button>
            </Grid>

            <!-- ================= Body ================= -->
            <Grid Grid.Row="1">

                <!-- Mode A: Update available / download / install / error -->
                <StackPanel x:Name="ReleaseView" Margin="22,6,22,18">
                    <!-- Hero header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="44" Height="44" CornerRadius="12" Background="#16233A"
                                BorderBrush="#263B5C" BorderThickness="1" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconSparkle}" Fill="#6EA7FF" Width="20" Height="20"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeroTitleText" FontFamily="{StaticResource FontDisplay}"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HeroSubtitleText" Style="{StaticResource CardDescText}"
                                       Margin="0,2,0,0"/>
                            <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                                <Border Background="#17233A" BorderBrush="#2C466B" BorderThickness="1"
                                        CornerRadius="7" Padding="8,2" Margin="0,0,8,4">
                                    <TextBlock x:Name="VersionDiffBadgeText" FontFamily="{StaticResource FontMono}"
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#8FB8F0"/>
                                </Border>
                                <TextBlock x:Name="PublishedAtText" Style="{StaticResource CaptionText}"
                                           Margin="0,0,8,4"/>
                                <TextBlock x:Name="AssetSizeText" Style="{StaticResource MonoText}"
                                           FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}"
                                           Margin="0,0,0,4"/>
                            </WrapPanel>
                        </StackPanel>

                        <Border x:Name="InstallModeChip" Grid.Column="2" Style="{StaticResource StatusChip}"
                                VerticalAlignment="Top" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="InstallModeDot" Width="5" Height="5" VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="InstallModeText" Style="{StaticResource ChipText}" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Development build warning banner -->
                    <Border x:Name="DevWarningBanner" Visibility="Collapsed"
                            Background="#1E170F" BorderBrush="#4C381F" BorderThickness="1"
                            CornerRadius="11" Padding="13,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconAlert}" Fill="#E7A762" Width="15" Height="15"
                                  Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock x:Name="DevWarningText" Grid.Column="1" Foreground="#F0C58B"
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
                        </Grid>
                    </Border>

                    <!-- Release notes card -->
                    <Border x:Name="ReleaseNotesCard" Style="{StaticResource Card}" Padding="14,12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="ReleaseNotesHeaderText" Style="{StaticResource FieldLabelText}"
                                           FontSize="12"/>
                                <Button x:Name="ReleaseNotesGitHubButton" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" Click="ViewOnGitHubButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExternal}" Width="11" Height="11"
                                              Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ReleaseNotesGitHubText" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource InnerTile}" Padding="12,10" Margin="0,9,0,0">
                                <ScrollViewer x:Name="ReleaseNotesScroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MinHeight="84" MaxHeight="190" Focusable="False">
                                    <TextBlock x:Name="ReleaseNotesText" FontSize="11.5"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               TextWrapping="Wrap" LineHeight="18"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Progress panel (Downloading / Verifying / Preparing / Restarting) -->
                    <Border x:Name="ProgressCard" Style="{StaticResource Card}" Padding="16,14"
                            Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="ProgressStageText" Style="{StaticResource FieldLabelText}"
                                           FontSize="12.5"/>
                                <TextBlock x:Name="ProgressPercentText" Style="{StaticResource MonoText}"
                                           FontSize="11.5" Foreground="#8FB8F0" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource ModernProgressBar}"
                                         Margin="0,12,0,9"/>
                            <TextBlock x:Name="ProgressDetailText" Style="{StaticResource MonoText}"
                                       FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Failure panel (download / checksum / staging / launch error) -->
                    <Border x:Name="FailureCard" Background="#1D1215" BorderBrush="#592A32" BorderThickness="1"
                            CornerRadius="12" Padding="14,12" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAlert}" Fill="#F26D6D" Width="14" Height="14"
                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="FailureTitleText" FontFamily="{StaticResource FontDisplay}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#F6A6A6"/>
                            </StackPanel>
                            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"
                                          Focusable="False">
                                <TextBlock x:Name="FailureMessageText" FontSize="11.5" Foreground="#E5B8BD"
                                           TextWrapping="Wrap" LineHeight="17"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Mode B: Compact manual check status card (UpToDate / CheckFailed / Checking) -->
                <StackPanel x:Name="StatusView" Margin="22,8,22,18" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="StatusIconBadge" Width="46" Height="46" CornerRadius="13"
                                BorderThickness="1" VerticalAlignment="Top">
                            <Path x:Name="StatusIconPath" Width="20" Height="20" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTitleText" FontFamily="{StaticResource FontDisplay}"
                                           FontSize="17" FontWeight="SemiBold" Margin="0,0,10,2"/>
                                <Border x:Name="StatusInstallModeChip" Style="{StaticResource StatusChip}"
                                        Padding="7,2" Margin="0,0,0,2">
                                    <TextBlock x:Name="StatusInstallModeText" Style="{StaticResource ChipText}"
                                               FontSize="10"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="StatusMessageText" Style="{StaticResource CardDescText}"
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="StatusCheckingPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <ProgressBar Style="{StaticResource ModernProgressBar}" IsIndeterminate="True"/>
                        <TextBlock x:Name="StatusCheckingText" Style="{StaticResource CaptionText}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border x:Name="StatusErrorBox" Style="{StaticResource InnerTile}"
                            Background="#181014" BorderBrush="#4A272D" Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <TextBlock x:Name="StatusErrorDetailText" Style="{StaticResource MonoText}"
                                       FontSize="10.5" Foreground="#E3A5AC" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ================= Bottom action bar ================= -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#1A1F29" Padding="22,14">
                <Grid>
                    <!-- Left action -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="SkipVersionButton" Style="{StaticResource GhostButton}"
                                Padding="11,7" Click="SkipVersionButton_Click"/>
                        <Button x:Name="FooterGitHubLinkButton" Style="{StaticResource LinkButton}"
                                Visibility="Collapsed" Click="ViewOnGitHubButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExternal}" Width="11" Height="11"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FooterGitHubLinkText" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RemindLaterButton" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="RemindLaterButton_Click"/>
                        <Button x:Name="UpdateNowButton" Style="{StaticResource AccentButton}"
                                Padding="18,8" FontSize="12" Click="UpdateNowButton_Click"/>
                        <Button x:Name="DevGitHubPrimaryButton" Style="{StaticResource AccentButton}"
                                Padding="16,8" FontSize="12" Visibility="Collapsed"
                                Click="ViewOnGitHubButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExternal}" Width="12" Height="12"
                                      Stretch="Uniform" Fill="White" Margin="0,0,7,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="DevGitHubPrimaryText" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelDownloadButton" Style="{StaticResource GhostButton}"
                                Visibility="Collapsed" Click="CancelDownloadButton_Click"/>
                        <Button x:Name="CloseFooterButton" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Visibility="Collapsed" Click="CloseButton_Click"/>
                        <Button x:Name="RetryButton" Style="{StaticResource AccentButton}"
                                Padding="18,8" FontSize="12" Visibility="Collapsed" Click="RetryButton_Click"/>
                        <Button x:Name="ClosePrimaryButton" Style="{StaticResource AccentButton}"
                                Padding="18,8" FontSize="12" Visibility="Collapsed" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
