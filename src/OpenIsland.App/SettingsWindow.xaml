<Window x:Class="OpenIsland.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Island — 设置"
        Width="1040"
        Height="720"
        MinWidth="880"
        MinHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontBody}"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1A202B" BorderBrush="#303949" BorderThickness="1"
                                CornerRadius="8" Padding="9,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Rounded, shadowed window surface. The 18px margin leaves room for the drop shadow. -->
    <Border x:Name="RootFrame" Margin="18" CornerRadius="16"
            BorderBrush="#262C38" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E1117" Offset="0"/>
                <GradientStop Color="#0B0D10" Offset="0.55"/>
                <GradientStop Color="#0A0C10" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="12" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= Title bar ================= -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Style="{StaticResource BrandMark}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="3.5" Height="10" CornerRadius="2" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center" Margin="0,0,2.5,0"/>
                            <Border Width="3.5" Height="17" CornerRadius="2" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center" Margin="0,0,2.5,0"/>
                            <Border Width="3.5" Height="13" CornerRadius="2" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Open Island" FontFamily="{StaticResource FontDisplay}" FontSize="13.5"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Width="1" Height="12" Background="#2A3140" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleVersionText" Style="{StaticResource MonoText}" FontSize="10.5"
                               Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,15,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}"
                            Click="MinimizeButton_Click">
                        <Path Data="{StaticResource IconMinus}" Width="12" Height="12" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}"
                            Margin="4,0,0,0" Click="CloseButton_Click">
                        <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Body ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Grid Grid.Column="0" Margin="14,8,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="SidebarSectionLabel" Style="{StaticResource CaptionText}"
                                   FontSize="9.5" FontWeight="SemiBold" Opacity="0.8"
                                   Margin="11,12,0,10"/>
                        <RadioButton x:Name="NavConnection" Style="{StaticResource NavItem}"
                                     GroupName="NavGroup" Uid="connection" Tag="{StaticResource IconBolt}"
                                     Content="连接状态" Checked="NavItem_Checked"/>
                        <RadioButton x:Name="NavAgents" Style="{StaticResource NavItem}"
                                     GroupName="NavGroup" Uid="agents" Tag="{StaticResource IconSparkle}"
                                     Content="Agent 接入" Checked="NavItem_Checked"/>
                        <RadioButton x:Name="NavUsage" Style="{StaticResource NavItem}"
                                     GroupName="NavGroup" Uid="usage" Tag="{StaticResource IconClock}"
                                     Content="用量监控" Checked="NavItem_Checked"/>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}"
                                     GroupName="NavGroup" Uid="appearance" Tag="{StaticResource IconDesktop}"
                                     Content="外观与显示" Checked="NavItem_Checked"/>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}"
                                     GroupName="NavGroup" Uid="general" Tag="{StaticResource IconGear}"
                                     Content="通用与音效" Checked="NavItem_Checked"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}"
                                     GroupName="NavGroup" Uid="about" Tag="{StaticResource IconInfo}"
                                     Content="关于" Checked="NavItem_Checked"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="6,0,6,0">
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="SidebarHotkeyLabel" Style="{StaticResource CaptionText}"
                                   Margin="2,0,0,6"/>
                        <Border Style="{StaticResource FooterChip}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SidebarHotkeyText" FontFamily="{StaticResource FontMono}"
                                           FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="1" Width="5" Height="5" Fill="#6EA7FF" Opacity="0.85"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Button x:Name="SidebarLogsButton" Style="{StaticResource SmallGhostButton}"
                                HorizontalAlignment="Stretch" Click="OpenLogsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="#9AA6B8" Margin="0,0,7,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="SidebarLogsLabel" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Width="1" Background="#1A1F29" Margin="0,16,0,16"/>

                <!-- Content area -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="28,20,28,10">
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitleText}"/>
                            <TextBlock x:Name="PageSubtitleText" Style="{StaticResource PageSubtitleText}"
                                       Margin="0,4,0,0" MaxWidth="600" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <TextBlock x:Name="PageIndexText" Grid.Column="1" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" FontFamily="{StaticResource FontMono}" FontSize="10.5"
                                   Foreground="{StaticResource BrushTextTertiary}" Margin="0,5,0,0"/>
                    </Grid>

                    <Grid Grid.Row="1">

                        <!-- ============ PAGE: Connection ============ -->
                        <ScrollViewer x:Name="PageConnection" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="28,2,22,22"
                                      Focusable="False">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="62" Height="62" Margin="0,0,12,0">
                                                <Ellipse x:Name="ConnPulseRing" Width="62" Height="62"
                                                         Fill="#6FB982" Opacity="0"
                                                         RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Ellipse.RenderTransform>
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     From="1" To="2.35" Duration="0:0:1.8"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                     From="1" To="2.35" Duration="0:0:1.8"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0.25" To="0" Duration="0:0:1.8"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Ellipse Width="38" Height="38" Fill="#12231C"/>
                                                <Ellipse x:Name="ConnStatusDot" Width="15" Height="15" Fill="#6FB982">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#5FCF87" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,18,0">
                                                <TextBlock x:Name="ConnStatusTitle" Style="{StaticResource CardTitleText}"
                                                           FontSize="17"/>
                                                <TextBlock x:Name="ConnStatusSubtitle" Style="{StaticResource CardDescText}"
                                                           Margin="0,3,0,0" MaxWidth="430" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="ConnPipeLabel" Style="{StaticResource CaptionText}"
                                                           HorizontalAlignment="Right"/>
                                                <Border Style="{StaticResource InnerTile}" Padding="9,6" Margin="0,5,0,0">
                                                    <TextBlock x:Name="ConnPipePathText" Style="{StaticResource MonoText}"
                                                               FontSize="10.5"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource Divider}" Margin="0,18,0,14"/>

                                        <UniformGrid Columns="4">
                                            <Border Style="{StaticResource InnerTile}" Margin="0,0,7,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="ActiveSessionsLabel" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="ActiveSessionsValue" Style="{StaticResource MetricValueText}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource InnerTile}" Margin="0,0,7,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="InstalledAgentsLabel" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="InstalledAgentsValue" Style="{StaticResource MetricValueText}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource InnerTile}" Margin="0,0,7,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="EventCountLabel" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="EventCountValue" Style="{StaticResource MetricValueText}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource InnerTile}">
                                                <StackPanel>
                                                    <TextBlock x:Name="LastEventLabel" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock x:Name="LastEventValue" Style="{StaticResource MetricValueText}"
                                                               FontSize="17" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="NoEventsHint" Style="{StaticResource Card}" Padding="16"
                                        Margin="0,0,0,12" Background="#101722" BorderBrush="#27354B">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="11" Background="#16233A"
                                                BorderBrush="#263B5C" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Border Width="3" Height="9" CornerRadius="1.5" Background="#6EA7FF"
                                                        Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <Border Width="3" Height="18" CornerRadius="1.5" Background="#8B7CF6"
                                                        Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <Border Width="3" Height="13" CornerRadius="1.5" Background="#6EA7FF"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="NoEventsTitle" Style="{StaticResource CardTitleText}"
                                                       FontSize="12.5"/>
                                            <TextBlock x:Name="NoEventsDesc" Style="{StaticResource CardDescText}"
                                                       Margin="0,3,0,0" MaxWidth="540" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconBolt}" Fill="#6EA7FF" Width="14" Height="14"
                                                          Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="SelfTestTitle" Style="{StaticResource CardTitleText}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="SelfTestDesc" Style="{StaticResource CardDescText}"
                                                           Margin="0,5,0,0" MaxWidth="470" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="16,0,0,0">
                                                <Button x:Name="OpenLogsButton" Style="{StaticResource GhostButton}"
                                                        Margin="0,0,8,0" Click="OpenLogsButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconFolder}" Width="12" Height="12"
                                                              Stretch="Uniform" Fill="#9AA6B8" Margin="0,0,6,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="OpenLogsButtonText" FontSize="11.5"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="RunSelfTestButton" Style="{StaticResource AccentButton}"
                                                        Padding="16,8" Click="RunSelfTestButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlay}" Width="10" Height="10"
                                                              Stretch="Uniform" Fill="White" Margin="0,0,7,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="RunSelfTestText" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="SelfTestFeedback" Visibility="Collapsed" Margin="0,10,0,0"
                                                   FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#131A24"
                                                BorderBrush="#253040" BorderThickness="1">
                                            <Path Data="{StaticResource IconTerminal}" Fill="#7FA8DF" Width="17"
                                                  Height="17" Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="HooksTitle" Style="{StaticResource CardTitleText}" FontSize="12.5"/>
                                            <TextBlock x:Name="HooksPathText" Style="{StaticResource MonoText}"
                                                       FontSize="10.5" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Border x:Name="HooksStatusChip" Style="{StaticResource StatusChip}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock x:Name="HooksStatusText" Style="{StaticResource ChipText}"/>
                                            </Border>
                                            <TextBlock x:Name="HooksVersionText" Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ PAGE: Agents ============ -->
                        <ScrollViewer x:Name="PageAgents" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,2,22,22" Focusable="False">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="AgentSummaryText" FontFamily="{StaticResource FontDisplay}"
                                                   FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AgentSummaryHint" Style="{StaticResource CaptionText}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="RefreshAgentsButton" Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,0" Click="RefreshAgentsButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconRefresh}" Width="12" Height="12"
                                                      Stretch="Uniform" Fill="#9AA6B8" Margin="0,0,6,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="RefreshAgentsText" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="InstallClaudeStatuslineButton" Style="{StaticResource GhostButton}"
                                                Click="InstallClaudeStatuslineButton_Click">
                                            <TextBlock x:Name="InstallClaudeStatuslineText" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="AgentsFeedback" Visibility="Collapsed" Opacity="0"
                                        Background="#111A20" BorderBrush="#2A4050" BorderThickness="1"
                                        CornerRadius="9" Padding="11,7" Margin="0,0,0,10"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="AgentsFeedbackDot" Width="6" Height="6" Fill="#6FB982"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="AgentsFeedbackText" FontSize="11" TextWrapping="Wrap"
                                                   MaxWidth="620"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="AgentsListHost"/>

                                <TextBlock x:Name="RestartAgentHintText" Style="{StaticResource CardDescText}"
                                           Margin="2,4,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ PAGE: Usage ============ -->
                        <ScrollViewer x:Name="PageUsage" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,2,22,22" Focusable="False">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock x:Name="UsagePrivacyText" Style="{StaticResource CardDescText}"
                                               VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Left"/>
                                    <Button x:Name="RefreshUsageButton" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="RefreshUsageButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefresh}" Width="12" Height="12"
                                                  Stretch="Uniform" Fill="#9AA6B8" Margin="0,0,6,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RefreshUsageText" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border x:Name="UsageHintBanner" Style="{StaticResource Card}" Padding="15"
                                        Margin="0,0,0,12" Background="#101722" BorderBrush="#27354B"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#16233A"
                                                BorderBrush="#263B5C" BorderThickness="1">
                                            <Path Data="{StaticResource IconClock}" Fill="#6EA7FF" Width="17" Height="17"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="UsageHintTitle" Style="{StaticResource CardTitleText}"
                                                       FontSize="12.5"/>
                                            <TextBlock x:Name="UsageHintDesc" Style="{StaticResource CardDescText}"
                                                       Margin="0,3,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="UsageCardsHost"/>

                                <TextBlock x:Name="UsageFooterHint" Style="{StaticResource CardDescText}"
                                           Margin="2,2,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ PAGE: Appearance ============ -->
                        <ScrollViewer x:Name="PageAppearance" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,2,22,22" Focusable="False">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform/>
                            </ScrollViewer.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDesktop}" Fill="#7FA8DF" Width="14"
                                                      Height="14" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="MonitorCardTitle" Style="{StaticResource CardTitleText}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="MonitorCardDesc" Style="{StaticResource CardDescText}"
                                                       Margin="0,4,0,10" MaxWidth="400" HorizontalAlignment="Left"/>
                                            <ComboBox x:Name="MonitorCombo" Style="{StaticResource DarkComboBox}"
                                                      HorizontalAlignment="Stretch"/>
                                            <TextBlock x:Name="MonitorHintText" Style="{StaticResource CaptionText}"
                                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource ArrowDown}" Stroke="#7FA8DF"
                                                      StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform"
                                                      Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="PositionCardTitle" Style="{StaticResource CardTitleText}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="PositionHintText" Style="{StaticResource CardDescText}"
                                                       Margin="0,4,0,0" MaxWidth="400" HorizontalAlignment="Left"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <RadioButton x:Name="PosTopRadio" Style="{StaticResource SelectableCardRadio}"
                                                             GroupName="PositionGroup" Margin="0,0,6,0"
                                                             Checked="AppearanceControl_Changed">
                                                    <StackPanel>
                                                        <Border Background="#090B0F" BorderBrush="#1F2530" BorderThickness="1"
                                                                CornerRadius="8" Height="64">
                                                            <Grid>
                                                                <Border Width="76" Height="12" CornerRadius="6"
                                                                        Background="#E7E1D3" HorizontalAlignment="Center"
                                                                        VerticalAlignment="Top" Margin="0,10,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock x:Name="PosTopLabel" FontSize="11" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="PosBottomRadio" Grid.Column="1"
                                                             Style="{StaticResource SelectableCardRadio}"
                                                             GroupName="PositionGroup" Margin="6,0,0,0"
                                                             Checked="AppearanceControl_Changed">
                                                    <StackPanel>
                                                        <Border Background="#090B0F" BorderBrush="#1F2530" BorderThickness="1"
                                                                CornerRadius="8" Height="64">
                                                            <Grid>
                                                                <Border Width="76" Height="12" CornerRadius="6"
                                                                        Background="#E7E1D3" HorizontalAlignment="Center"
                                                                        VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock x:Name="PosBottomLabel" FontSize="11" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="ThemeCardTitle" Style="{StaticResource CardTitleText}"/>
                                            <TextBlock x:Name="ThemeHintText" Style="{StaticResource CardDescText}"
                                                       Margin="0,4,0,10" HorizontalAlignment="Left"/>
                                            <RadioButton x:Name="ThemeInkRadio" Style="{StaticResource SelectableCardRadio}"
                                                         GroupName="ThemeGroup" Margin="0,0,0,8"
                                                         Checked="AppearanceControl_Changed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="9" Background="#050608"
                                                            BorderBrush="#2B3240" BorderThickness="1" Margin="0,0,11,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="ThemeInkLabel" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="ThemeInkDescText" FontSize="10"
                                                                   Foreground="{StaticResource BrushTextTertiary}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </RadioButton>
                                            <RadioButton x:Name="ThemeGraphiteRadio" Style="{StaticResource SelectableCardRadio}"
                                                         GroupName="ThemeGroup" Checked="AppearanceControl_Changed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="9" Margin="0,0,11,0"
                                                            BorderBrush="#3A4250" BorderThickness="1">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#3A414D" Offset="0"/>
                                                                <GradientStop Color="#20252E" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="ThemeGraphiteLabel" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="ThemeGraphiteDescText" FontSize="10"
                                                                   Foreground="{StaticResource BrushTextTertiary}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="15">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="PreviewCardTitle" Style="{StaticResource CardTitleText}"
                                                           FontSize="12.5"/>
                                                <TextBlock x:Name="PreviewMetaText" Style="{StaticResource CaptionText}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Background="#07090C" BorderBrush="#1F2530" BorderThickness="1"
                                                    CornerRadius="12" Height="150" Margin="0,10,0,0" ClipToBounds="True">
                                                <Grid>
                                                    <Border>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#16233A" Offset="0"/>
                                                                <GradientStop Color="#10141D" Offset="0.6"/>
                                                                <GradientStop Color="#090B10" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Ellipse Width="180" Height="100" Fill="#294A78" Opacity="0.18"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Margin="0,0,-40,-30"/>
                                                    <Border x:Name="PreviewPill" HorizontalAlignment="Center"
                                                            VerticalAlignment="Top" Margin="0,12,0,0"
                                                            Background="#08090B" BorderBrush="#333A46" BorderThickness="1"
                                                            CornerRadius="14" Padding="9,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Margin="0,0,7,0">
                                                                <Border Width="2.5" Height="7" CornerRadius="1.5"
                                                                        Background="#F1EAD9" Margin="0,0,2,0"/>
                                                                <Border Width="2.5" Height="12" CornerRadius="1.5"
                                                                        Background="#F1EAD9" Margin="0,0,2,0"/>
                                                                <Border Width="2.5" Height="9" CornerRadius="1.5"
                                                                        Background="#F1EAD9"/>
                                                            </StackPanel>
                                                            <TextBlock Text="Open Island" FontSize="9.5" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <Ellipse Width="4.5" Height="4.5" Fill="#6FB982"
                                                                     Margin="9,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="PreviewStatusText" FontSize="8.5"
                                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                            <Path Data="{StaticResource ChevronRight}" Stroke="#7D889B"
                                                                  StrokeThickness="1.2" Width="4" Height="7"
                                                                  Stretch="Uniform" VerticalAlignment="Center"
                                                                  Margin="9,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="PreviewHintText" Style="{StaticResource CardDescText}"
                                                       Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- ============ PAGE: General ============ -->
                        <ScrollViewer x:Name="PageGeneral" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,2,22,22" Focusable="False">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel>
                                <!-- System -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconGear}" Fill="#7FA8DF" Width="14" Height="14"
                                                  Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SystemTitle" Style="{StaticResource CardTitleText}"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Divider}" Margin="0,13,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="LanguageLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="LanguageHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="380"
                                                           HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SegmentedGroup}">
                                                <Grid x:Name="LanguageSegmentHost">
                                                    <!-- Sliding pill: animates between 中文 / English when the selection changes. -->
                                                    <Border x:Name="LanguageSegmentPill" CornerRadius="7"
                                                            Background="#243044" BorderBrush="#35507A" BorderThickness="1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Width="0" Height="0" Visibility="Collapsed"
                                                            IsHitTestVisible="False">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="LanguageSegmentPillTransform"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="LanguageZhSegment" Style="{StaticResource SegmentedItem}"
                                                                     GroupName="LanguageGroup" Content="中文"
                                                                     Checked="LanguageSegment_Checked"/>
                                                        <RadioButton x:Name="LanguageEnSegment" Style="{StaticResource SegmentedItem}"
                                                                     GroupName="LanguageGroup" Content="English" Margin="2,0,0,0"
                                                                     Checked="LanguageSegment_Checked"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="StartupLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="StartupHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="AutoCheckUpdatesLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="AutoCheckUpdatesHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoCheckUpdatesToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Notifications -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSound}" Fill="#7FA8DF" Width="14" Height="14"
                                                  Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NotificationTitle" Style="{StaticResource CardTitleText}"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Divider}" Margin="0,13,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="SoundLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="SoundHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SoundToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SoundSchemeLabel" Style="{StaticResource FieldLabelText}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ComboBox x:Name="SoundCombo" Style="{StaticResource DarkComboBox}"
                                                          Width="170" Height="34" Padding="10,0" Margin="0,0,8,0">
                                                    <ComboBoxItem Content="Asterisk" Tag="Asterisk"/>
                                                    <ComboBoxItem Content="Exclamation" Tag="Exclamation"/>
                                                    <ComboBoxItem Content="Beep" Tag="Beep"/>
                                                    <ComboBoxItem Content="Hand" Tag="Hand"/>
                                                    <ComboBoxItem Content="Notify" Tag="Notify"/>
                                                    <ComboBoxItem Content="Ding" Tag="Ding"/>
                                                    <ComboBoxItem Content="Chimes" Tag="Chimes"/>
                                                    <ComboBoxItem Content="Tada" Tag="Tada"/>
                                                    <ComboBoxItem Content="Windows Notify" Tag="WindowsNotify"/>
                                                </ComboBox>
                                                <Button x:Name="PreviewSoundButton" Style="{StaticResource SmallGhostButton}"
                                                        Click="PreviewSoundButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlay}" Width="8" Height="9"
                                                              Stretch="Uniform" Fill="#9AA6B8" Margin="0,0,6,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="PreviewSoundText" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="AutoExpandApprovalLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="AutoExpandApprovalHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoExpandApprovalToggle" Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Behaviour -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSparkle}" Fill="#7FA8DF" Width="14" Height="14"
                                                  Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="BehaviorTitle" Style="{StaticResource CardTitleText}"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Divider}" Margin="0,13,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="AutoExpandCompleteLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="AutoExpandCompleteHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoExpandCompleteToggle" Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="CoalesceRecurringLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="CoalesceRecurringHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="CoalesceRecurringToggle" Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="AutoHideIslandLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="AutoHideIslandHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoHideIslandToggle" Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <StackPanel Margin="0,14,0,0">
                                            <Grid>
                                                <TextBlock x:Name="AutoHideDelayLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="AutoHideDelayValue" HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource FontMono}" FontSize="10.5"
                                                           Foreground="{StaticResource SettingsAccent}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="AutoHideDelaySlider" Style="{StaticResource ModernSlider}"
                                                    Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    SmallChange="5" LargeChange="10" Margin="0,6,0,0"
                                                    ValueChanged="Slider_ValueChanged"/>
                                            <TextBlock x:Name="AutoHideDelayHintText" Style="{StaticResource CardDescText}"
                                                       Margin="0,0,0,0" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <StackPanel Margin="0,14,0,0">
                                            <Grid>
                                                <TextBlock x:Name="CompletionDurationLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="CompletionDurationValue" HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource FontMono}" FontSize="10.5"
                                                           Foreground="{StaticResource SettingsAccent}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="CompletionDurationSlider" Style="{StaticResource ModernSlider}"
                                                    Minimum="3" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="2" Margin="0,6,0,0"
                                                    ValueChanged="Slider_ValueChanged"/>
                                            <TextBlock x:Name="CompletionDurationHintText" Style="{StaticResource CardDescText}"
                                                       Margin="0,0,0,0" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <StackPanel Margin="0,14,0,0">
                                            <Grid>
                                                <TextBlock x:Name="PollIntervalLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="PollIntervalValue" HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource FontMono}" FontSize="10.5"
                                                           Foreground="{StaticResource SettingsAccent}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="PollSlider" Style="{StaticResource ModernSlider}"
                                                    Minimum="1000" Maximum="15000" TickFrequency="500"
                                                    IsSnapToTickEnabled="True" SmallChange="500" LargeChange="1000"
                                                    Margin="0,6,0,0" ValueChanged="Slider_ValueChanged"/>
                                            <TextBlock x:Name="PollIntervalHintText" Style="{StaticResource CardDescText}"
                                                       Margin="0,0,0,0" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="CodexAppServerLabel" Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock x:Name="CodexAppServerHintText" Style="{StaticResource CaptionText}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <CheckBox x:Name="CodexAppServerToggle" Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ PAGE: About ============ -->
                        <ScrollViewer x:Name="PageAbout" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,2,22,22" Focusable="False">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform/>
                            </ScrollViewer.RenderTransform>
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="78" Height="78" CornerRadius="22" Background="#151A22"
                                                BorderBrush="#2A3140" BorderThickness="1" Margin="0,0,18,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Border Width="6" Height="22" CornerRadius="3" Background="{StaticResource BrushPaper}"
                                                        Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <Border Width="6" Height="40" CornerRadius="3" Background="{StaticResource BrushPaper}"
                                                        Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <Border Width="6" Height="30" CornerRadius="3" Background="{StaticResource BrushPaper}"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Open Island" FontFamily="{StaticResource FontDisplay}"
                                                           FontSize="21" FontWeight="SemiBold"/>
                                                <Border Background="#17233A" BorderBrush="#2C466B" BorderThickness="1"
                                                        CornerRadius="7" Padding="7,2" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="AboutVersionText" FontFamily="{StaticResource FontMono}"
                                                               FontSize="10" Foreground="#8FB8F0"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="AboutTaglineText" Style="{StaticResource PageSubtitleText}"
                                                       FontSize="12.5" Margin="0,5,0,0" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="AboutTechText" Style="{StaticResource MonoText}"
                                                       Foreground="{StaticResource BrushTextTertiary}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Software Update -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconRefresh}" Fill="#7FA8DF" Width="14" Height="14"
                                                      Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="AboutUpdateTitle" Style="{StaticResource CardTitleText}"/>
                                                <Border x:Name="AboutUpdateStatusChip" Style="{StaticResource StatusChip}"
                                                        Margin="10,0,0,0" Padding="7,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="AboutUpdateStatusDot" Width="5" Height="5"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock x:Name="AboutUpdateStatusChipText" Style="{StaticResource ChipText}"
                                                                   FontSize="10"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="AboutUpdateDetailText" Style="{StaticResource CardDescText}"
                                                       Margin="0,5,0,0" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="AboutOpenUpdateButton" Style="{StaticResource AccentButton}"
                                                    Padding="14,7" FontSize="11.5" Margin="0,0,8,0"
                                                    Visibility="Collapsed" Click="AboutOpenUpdateButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconSparkle}" Width="11" Height="11"
                                                          Stretch="Uniform" Fill="White" Margin="0,0,6,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="AboutOpenUpdateText" FontSize="11.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="CheckUpdatesButton" Style="{StaticResource GhostButton}"
                                                    Click="CheckUpdatesButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Width="12" Height="12"
                                                          Stretch="Uniform" Fill="#9AA6B8" Margin="0,0,6,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="CheckUpdatesButtonText" FontSize="11.5"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}"
                                            Padding="15" Margin="0,0,6,12">
                                        <StackPanel>
                                            <TextBlock x:Name="WinRepoLabel" Style="{StaticResource CaptionText}"/>
                                            <Button x:Name="WinRepoLinkButton" Style="{StaticResource LinkButton}"
                                                    Margin="0,7,0,0" HorizontalAlignment="Stretch"
                                                    Click="WinRepoLinkButton_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="{StaticResource IconExternal}" Width="11" Height="11"
                                                          Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="github.com/zhengbaiyang/open-vibe-island-win11"
                                                               FontSize="11" FontFamily="{StaticResource FontMono}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}"
                                            Padding="15" Margin="6,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="UpstreamLabel" Style="{StaticResource CaptionText}"/>
                                            <Button x:Name="UpstreamLinkButton" Style="{StaticResource LinkButton}"
                                                    Margin="0,7,0,0" HorizontalAlignment="Stretch"
                                                    Click="UpstreamLinkButton_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="{StaticResource IconExternal}" Width="11" Height="11"
                                                          Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="github.com/Octane0411/open-vibe-island"
                                                               FontSize="11" FontFamily="{StaticResource FontMono}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}"
                                            Padding="15" Margin="0,0,6,12">
                                        <StackPanel>
                                            <TextBlock x:Name="LicenseLabel" Style="{StaticResource CaptionText}"/>
                                            <TextBlock x:Name="LicenseValueText" FontSize="11.5" FontWeight="SemiBold"
                                                       Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"
                                            Padding="15" Margin="6,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="HotkeyCardLabel" Style="{StaticResource CaptionText}"/>
                                            <Border Style="{StaticResource FooterChip}" HorizontalAlignment="Left"
                                                    Margin="0,7,0,0" Padding="9,5">
                                                <TextBlock x:Name="HotkeyValueText" FontFamily="{StaticResource FontMono}"
                                                           FontSize="10.5" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}"
                                            Padding="15" Margin="0,0,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="DataDirLabel" Style="{StaticResource CaptionText}"/>
                                                <Button x:Name="CopyDataDirButton" Style="{StaticResource LinkButton}"
                                                        HorizontalAlignment="Right" Click="CopyDataDirButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCopy}" Width="10" Height="10"
                                                              Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="CopyDataDirLabel" FontSize="10.5"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="DataDirPathText" Style="{StaticResource MonoText}"
                                                       FontSize="10.5" Margin="0,7,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip=""/>
                                            <TextBlock x:Name="CopiedFeedbackText" FontSize="10" Foreground="#6FB982"
                                                       Visibility="Collapsed" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Card}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#12231C"
                                                BorderBrush="#254434" BorderThickness="1" Margin="0,0,13,0">
                                            <Path Data="{StaticResource IconShield}" Fill="#6FB982" Width="17" Height="17"
                                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="PrivacyTitleText" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="PrivacyDescText" Style="{StaticResource CardDescText}"
                                                       Margin="0,3,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ Bottom action bar ============ -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#1A1F29" Padding="28,0">
                        <Grid Height="64">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="#6EA7FF" Opacity="0.9" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ApplyHintText" Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="SaveToast" Visibility="Collapsed" Opacity="0"
                                        Background="#13241C" BorderBrush="#2C5843" BorderThickness="1"
                                        CornerRadius="9" Padding="10,6" Margin="0,0,12,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheck}" Width="10" Height="9" Stretch="Uniform"
                                              Fill="#6FB982" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SaveToastText" FontSize="11" Foreground="#8ED7A5"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}"
                                        Click="SaveButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheck}" Width="11" Height="10" Stretch="Uniform"
                                              Fill="White" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SaveButtonText" FontSize="12.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
