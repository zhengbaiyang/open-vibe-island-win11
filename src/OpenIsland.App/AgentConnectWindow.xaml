<Window x:Class="OpenIsland.App.AgentConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Island — 发现可接入的 Agent"
        Width="600"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontBody}"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1A202B" BorderBrush="#303949" BorderThickness="1"
                                CornerRadius="8" Padding="9,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootFrame" Margin="20,18,20,22">
        <Border Margin="1" CornerRadius="15" Background="#0B0D10" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.18"
                                  RenderingBias="Quality"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="16" BorderBrush="#262C38" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E1117" Offset="0"/>
                    <GradientStop Color="#0B0D10" Offset="0.55"/>
                    <GradientStop Color="#0A0C10" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Style="{StaticResource BrandMark}" Width="26" Height="26" CornerRadius="8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="3" Height="8.5" CornerRadius="1.5" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <Border Width="3" Height="11" CornerRadius="1.5" Background="{StaticResource BrushPaper}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TitleBarText" FontFamily="{StaticResource FontDisplay}"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource CloseWindowButton}"
                        Margin="0,0,12,0" VerticalAlignment="Center" Click="CloseButton_Click">
                    <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                </Button>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="22,4,22,16">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#16233A"
                            BorderBrush="#2C466B" BorderThickness="1" Margin="0,2,14,0"
                            VerticalAlignment="Top">
                        <Path Data="{StaticResource IconSparkle}" Fill="#6EA7FF" Width="18" Height="18"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HeaderTitleText" FontFamily="{StaticResource FontDisplay}"
                                   FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeaderSubtitleText" Style="{StaticResource CardDescText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="CandidatesHost"/>
                </ScrollViewer>

                <Border x:Name="ResultBanner" Visibility="Collapsed" Margin="0,12,0,0"
                        Background="#11221B" BorderBrush="#28503E" BorderThickness="1"
                        CornerRadius="11" Padding="13,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ResultIcon" Data="{StaticResource IconCheck}" Width="13" Height="13"
                                  Stretch="Uniform" Fill="#6FB982" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ResultTitleText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#A9D9B9" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="ResultHintText" Style="{StaticResource CaptionText}"
                                   Margin="21,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#1C222D"
                    Padding="22,14,22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="DontAskButton" Grid.Column="0" Style="{StaticResource GhostButton}"
                            Padding="13,8" Click="DontAskButton_Click"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="LaterButton" Style="{StaticResource GhostButton}"
                                Padding="15,8" Margin="0,0,8,0" Click="LaterButton_Click"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}"
                                Padding="18,8" Click="ConfirmButton_Click"/>
                        <Button x:Name="DoneButton" Style="{StaticResource AccentButton}"
                                Padding="20,8" Visibility="Collapsed" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
