<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Settings-window & auxiliary dialog design system.
        All semantic brushes below act as design-time / default tokens and are updated live
        on Application.Current.Resources by SettingsThemeManager (Light / Dark / Follow-System).
        Every style here is keyed so the floating IslandWindow is never affected.
    -->

    <!-- ============================================================
         Default semantic tokens (overridden live by SettingsThemeManager)
         ============================================================ -->
    <LinearGradientBrush x:Key="SettingsWindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#151922" Offset="0"/>
        <GradientStop Color="#12151C" Offset="0.55"/>
        <GradientStop Color="#101319" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SettingsWindowShadowFill" Color="#12151C"/>
    <SolidColorBrush x:Key="SettingsWindowBorder" Color="#2A3242"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6EA7FF" Offset="0"/>
        <GradientStop Color="#8B7CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#82B5FF" Offset="0"/>
        <GradientStop Color="#A08FFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SettingsProgressIndeterminateBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#006EA7FF" Offset="0.0"/>
        <GradientStop Color="#6EA7FF" Offset="0.35"/>
        <GradientStop Color="#8B7CF6" Offset="0.70"/>
        <GradientStop Color="#008B7CF6" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1CFFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>

