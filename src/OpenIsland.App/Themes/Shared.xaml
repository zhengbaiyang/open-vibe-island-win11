<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Design tokens — Open Island (v8 "ink & paper" inspired)
         ============================================================ -->

    <!-- Surfaces -->
    <Color x:Key="ColorInk">#0B0D10</Color>
    <Color x:Key="ColorInkRaised">#101319</Color>
    <Color x:Key="ColorSurface">#141821</Color>
    <Color x:Key="ColorSurfaceHover">#1B202B</Color>
    <Color x:Key="ColorSurfaceActive">#202634</Color>
    <Color x:Key="ColorStroke">#242A36</Color>
    <Color x:Key="ColorStrokeSoft">#1A1F29</Color>
    <Color x:Key="ColorPaper">#F1EAD9</Color>

    <!-- Text -->
    <Color x:Key="ColorTextPrimary">#F2F4F8</Color>
    <Color x:Key="ColorTextSecondary">#A6B0C0</Color>
    <Color x:Key="ColorTextTertiary">#6F7B8F</Color>
    <Color x:Key="ColorTextDisabled">#4B5566</Color>

    <!-- Status palette (mirrors macOS IslandDesignPalette) -->
    <Color x:Key="ColorRunning">#6EA7FF</Color>
    <Color x:Key="ColorWaitingAggregate">#E7A762</Color>
    <Color x:Key="ColorWaitingApproval">#F4A4A4</Color>
    <Color x:Key="ColorWaitingAnswer">#FFD58A</Color>
    <Color x:Key="ColorCompleted">#6FB982</Color>
    <Color x:Key="ColorDanger">#F26D6D</Color>
    <Color x:Key="ColorPositive">#6FB982</Color>

    <SolidColorBrush x:Key="BrushInk" Color="{StaticResource ColorInk}"/>
    <SolidColorBrush x:Key="BrushInkRaised" Color="{StaticResource ColorInkRaised}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}"/>
    <SolidColorBrush x:Key="BrushSurfaceActive" Color="{StaticResource ColorSurfaceActive}"/>
    <SolidColorBrush x:Key="BrushStroke" Color="{StaticResource ColorStroke}"/>
    <SolidColorBrush x:Key="BrushStrokeSoft" Color="{StaticResource ColorStrokeSoft}"/>
    <SolidColorBrush x:Key="BrushPaper" Color="{StaticResource ColorPaper}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}"/>
    <SolidColorBrush x:Key="BrushTextDisabled" Color="{StaticResource ColorTextDisabled}"/>

    <SolidColorBrush x:Key="BrushRunning" Color="{StaticResource ColorRunning}"/>
    <SolidColorBrush x:Key="BrushWaitingAggregate" Color="{StaticResource ColorWaitingAggregate}"/>
    <SolidColorBrush x:Key="BrushWaitingApproval" Color="{StaticResource ColorWaitingApproval}"/>
    <SolidColorBrush x:Key="BrushWaitingAnswer" Color="{StaticResource ColorWaitingAnswer}"/>
    <SolidColorBrush x:Key="BrushCompleted" Color="{StaticResource ColorCompleted}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushPositive" Color="{StaticResource ColorPositive}"/>

    <SolidColorBrush x:Key="BrushWhite06" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="BrushWhite10" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BrushWhite16" Color="#29FFFFFF"/>

    <!-- Typography -->
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Cascadia Code, Consolas, Microsoft YaHei UI</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ============================================================
         Buttons
         ============================================================ -->

    <Style TargetType="Button" x:Key="PillButton">
        <Setter Property="Background" Value="#1B202A"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#262C39"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#151920"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="ApproveButton" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="#1E7A4E"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="Button" x:Key="DenyButton" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="#8F2F33"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Circular / square icon button (transparent until hover). -->
    <Style TargetType="Button" x:Key="IconButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small pill chip (labels like agent name / terminal / elapsed). -->
    <Style TargetType="Border" x:Key="Chip">
        <Setter Property="Background" Value="#0FFFFFFF"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Slim scrollbar used inside cards/lists. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#33FFFFFF" CornerRadius="3" Margin="1,2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin vertical divider -->
    <Style TargetType="Border" x:Key="Divider">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource BrushStrokeSoft}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

</ResourceDictionary>
