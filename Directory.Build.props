<Project>
  <!-- Shared assembly/product metadata for all Open Island executables. -->
  <PropertyGroup>
    <Version>0.1.4</Version>
    <FileVersion>0.1.4.0</FileVersion>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <InformationalVersion>0.1.4-win11</InformationalVersion>
    <Product>Open Island</Product>
    <Company>Open Island — Windows 11 port of open-vibe-island</Company>
    <Copyright>GNU GPL-3.0 · upstream Octane0411/open-vibe-island</Copyright>
    <RepositoryUrl>https://github.com/Octane0411/open-vibe-island</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
